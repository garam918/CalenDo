<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/widget_item_plan_linear"
    android:layout_marginStart="3dp"
    android:layout_marginTop="3dp"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/widget_plan_title_img"
        android:layout_gravity="center"
        android:padding="2.5dp"
        android:background="@drawable/todo_item_icon_bg"
        android:src="@drawable/todo_icon_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_weight="5"
        android:layout_gravity="center"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:id="@+id/widget_item_plan_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_weight="1"
        android:layout_gravity="center"
        android:layout_marginStart="10dp"
        android:textSize="14sp"
        android:alpha="0.5"
        android:textColor="@color/color_gray100"
        android:id="@+id/widget_item_plan_start_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>



</LinearLayout>