<LinearLayout
    android:id="@+id/widget_container"
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.TodoList.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:theme="@style/Theme.TodoList.AppWidgetContainer">

    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:textAppearance="@style/widget_date_text_style"
            android:id="@+id/widget_today_text"
            android:text=""
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:padding="5dp"
            android:layout_marginStart="6dp"
            android:id="@+id/widget_refresh_btn"
            android:src="@drawable/widget_refresh_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>



    <ListView
        android:divider="@null"
        android:dividerHeight="0dp"
        android:id="@+id/widget_todo_list_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


</LinearLayout>